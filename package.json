{
  "name": "leetcode-visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive, step-by-step visualizations for every solution in java-leetcode-solutions.",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "extract": "node scripts/extract-solutions.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsx scripts/check-tracers.ts",
    "typecheck": "tsc -b --force",
    "verify": "node scripts/verify-visualization.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  }
}
